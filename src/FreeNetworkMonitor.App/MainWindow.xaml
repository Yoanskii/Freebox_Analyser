<Window x:Class="FreeNetworkMonitor.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FreeNetworkMonitor.App" Title="Free Network Monitor" Width="1280" Height="900" MinWidth="900" MinHeight="650">
<Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DockPanel Margin="0,0,0,20"><StackPanel><TextBlock Text="FREE NETWORK MONITOR" FontSize="26" FontWeight="Bold"/><TextBlock Text="Votre connexion, observée avec précision." Foreground="#50DFD2"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Réduire dans la zone de notification" Click="MinimizeToTray"/><Button Content="Quitter" Click="Quit"/></StackPanel></DockPanel>
<TabControl Grid.Row="1">
<TabItem Header="Tableau de bord"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,16,0,0">
<Border Background="{StaticResource Panel}" CornerRadius="10" Padding="16"><StackPanel><DockPanel><TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontWeight="SemiBold"/><Button Content="Suspendre / reprendre" Command="{Binding Pause}" HorizontalAlignment="Right"/></DockPanel><TextBlock Text="{Binding SessionText}" Foreground="#50DFD2"/><TextBlock Text="{Binding BaselineText}" FontSize="12"/></StackPanel></Border>
<TextBlock Text="{Binding MetricContext}" Margin="0,16,0,8"/>
<UniformGrid Columns="4"><Border Background="{StaticResource Panel}" CornerRadius="10" Padding="16" Margin="0,0,8,0"><StackPanel><TextBlock Text="LATENCE MOYENNE · ms" FontSize="12"/><TextBlock Text="{Binding Mean}" FontSize="32" FontWeight="SemiBold"/></StackPanel></Border><Border Background="{StaticResource Panel}" CornerRadius="10" Padding="16" Margin="0,0,8,0"><StackPanel><TextBlock Text="PERTES SONDES ICMP · %" FontSize="12"/><TextBlock Text="{Binding Loss}" FontSize="32" FontWeight="SemiBold"/></StackPanel></Border><Border Background="{StaticResource Panel}" CornerRadius="10" Padding="16" Margin="0,0,8,0"><StackPanel><TextBlock Text="GIGUE DES SONDES · ms" FontSize="12"/><TextBlock Text="{Binding Jitter}" FontSize="32" FontWeight="SemiBold"/></StackPanel></Border><Border Background="{StaticResource Panel}" CornerRadius="10" Padding="16"><StackPanel><TextBlock Text="INCIDENTS DANS LA FENÊTRE" FontSize="12"/><TextBlock Text="{Binding IncidentCount}" FontSize="32" FontWeight="SemiBold"/></StackPanel></Border></UniformGrid>
<TextBlock Text="RTT en temps réel · choisir une destination dans le tableau · molette pour zoomer · survol pour les détails" Margin="0,16,0,6"/>
<Border Background="{StaticResource Panel}" CornerRadius="10" Padding="8"><local:ProbeChart Height="245" Probes="{Binding Plot}" AutomationProperties.Name="Graphique des RTT ICMP en millisecondes, échecs et temps" Focusable="True"/></Border>
<DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" IsReadOnly="True" Height="205" Margin="0,14,0,0" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="Destination / source" Binding="{Binding Name}" Width="180"/><DataGridTextColumn Header="IP effective" Binding="{Binding Address}" Width="130"/><DataGridTextColumn Header="RTT ms" Binding="{Binding Mean}" Width="75"/><DataGridTextColumn Header="Pertes %" Binding="{Binding Loss}" Width="75"/><DataGridTextColumn Header="Statut / méthode" Binding="{Binding Quality}" Width="250"/><DataGridTextColumn Header="Sondes / invalides" Binding="{Binding Samples}" Width="400"/></DataGrid.Columns></DataGrid>
<TextBlock Text="{Binding DiagnosisText}" TextWrapping="Wrap" Margin="0,12" FontWeight="SemiBold"/><TextBlock Text="ICMP peut être limité ou dépriorisé. Ces mesures ne prouvent pas des pertes UDP/TCP du jeu. Une valeur — signifie une mesure indisponible, jamais zéro." TextWrapping="Wrap" FontSize="12" Foreground="#BDCCDF"/>
<WrapPanel Margin="0,10"><TextBox Text="{Binding ManualGame}" Width="230" AutomationProperties.Name="Nom de la session manuelle"/><Button Content="Démarrer une session manuelle" Command="{Binding StartSession}"/><Button Content="Arrêter la session" Command="{Binding EndSession}"/><Button Content="Consulter le dernier rapport" Click="LastReport"/></WrapPanel>
</StackPanel></ScrollViewer></TabItem>
<TabItem Header="Sessions"><Grid Margin="0,16,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><WrapPanel><TextBox Width="240" Text="{Binding Filter}" ToolTip="Rechercher par jeu ou date" AutomationProperties.Name="Recherche de sessions"/><DatePicker SelectedDate="{Binding FromDate}" Width="140" ToolTip="Date de début"/><DatePicker SelectedDate="{Binding ToDate}" Width="140" ToolTip="Date de fin"/><Button Content="Rechercher / actualiser" Command="{Binding RefreshHistory}"/></WrapPanel>
<DataGrid Grid.Row="1" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" IsReadOnly="True" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="Jeu" Binding="{Binding Game}" Width="*"/><DataGridTextColumn Header="Début local" Binding="{Binding Start}" Width="140"/><DataGridTextColumn Header="Durée" Binding="{Binding Duration}" Width="90"/><DataGridTextColumn Header="État" Binding="{Binding State}" Width="220"/><DataGridTextColumn Header="Baseline" Binding="{Binding Baseline}" Width="220"/><DataGridTextColumn Header="Incidents" Binding="{Binding Incidents}" Width="75"/></DataGrid.Columns></DataGrid>
<ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding SessionDetail}" TextWrapping="Wrap" Margin="12"/></ScrollViewer><WrapPanel Grid.Row="3"><Button Content="Ouvrir le rapport et ses graphiques" Command="{Binding ShowReport}"/><Button Content="Exporter CSV + JSON + HTML" Command="{Binding ExportSession}"/><TextBlock Text="Le rapport HTML est imprimable en PDF." VerticalAlignment="Center"/></WrapPanel></Grid></TabItem>
<TabItem Header="Paramètres"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,16,0,0"><TextBlock Text="Mesures légères • 4 cibles par défaut • aucun compte ni télémétrie" FontSize="20"/>
<GroupBox Header="Destinations • 1 à 8 cibles actives"><StackPanel><TextBlock Text="La passerelle auto suit l’interface observée. Une adresse DNS est résolue à chaque sonde ; les changements d’IP sont tracés." TextWrapping="Wrap"/><DataGrid x:Name="TargetGrid" ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTargetSetting}" CanUserAddRows="False" Height="220"><DataGrid.Columns><DataGridCheckBoxColumn Header="Active" Binding="{Binding Enabled}"/><DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Adresse IP ou DNS (auto pour passerelle)" Binding="{Binding Host}" Width="*"/><DataGridTextColumn Header="Type" Binding="{Binding Kind}" IsReadOnly="True" Width="110"/></DataGrid.Columns></DataGrid><WrapPanel><Button Content="Ajouter une cible" Command="{Binding AddTarget}"/><Button Content="Supprimer" Command="{Binding RemoveTarget}"/><Button Content="Tester la sélection" Command="{Binding TestTarget}"/><Button Content="Valeurs recommandées" Command="{Binding RestoreTargets}"/></WrapPanel><CheckBox Content="Autoriser le remplacement d’une cible externe jamais mesurable par OpenDNS (208.67.222.222), après validation" IsChecked="{Binding Draft.AutoReplaceUnmeasurable}"/></StackPanel></GroupBox>
<GroupBox Header="Jeux détectés • aucun hook ni injection"><StackPanel><TextBlock Text="ARC Raiders : nom présumé à vérifier sur votre installation. Le premier jeu du catalogue est prioritaire ; une session active conserve sa priorité." TextWrapping="Wrap"/><DataGrid x:Name="GameGrid" ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}" CanUserAddRows="False" Height="180"><DataGrid.Columns><DataGridCheckBoxColumn Header="Actif" Binding="{Binding Enabled}"/><DataGridTextColumn Header="Nom du jeu" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Nom du processus (sans .exe)" Binding="{Binding ProcessName}" Width="*"/><DataGridTextColumn Header="Chemin facultatif (strict si renseigné)" Binding="{Binding Path}" Width="2*"/></DataGrid.Columns></DataGrid><WrapPanel><Button Content="Ajouter un exécutable…" Command="{Binding AddGame}"/><Button Content="Supprimer le jeu" Command="{Binding RemoveGame}"/></WrapPanel></StackPanel></GroupBox>
<CheckBox Content="Notifications dans la zone Windows (temporisation anti-spam de 60 s)" IsChecked="{Binding Draft.Notifications}"/><CheckBox Content="Démarrer avec Windows (utilisateur courant, sans élévation)" IsChecked="{Binding Draft.StartWithWindows}"/>
<WrapPanel><TextBlock Text="Conserver les données (jours)" VerticalAlignment="Center"/><TextBox Width="85" Text="{Binding Draft.RetentionDays}" AutomationProperties.Name="Rétention en jours"/><Button Content="Choisir le dossier d’export…" Command="{Binding SelectExportFolder}"/><TextBlock Text="{Binding Draft.ExportFolder}" VerticalAlignment="Center"/></WrapPanel>
<Expander Header="Avancé : intervalles, seuils et temporisations" Margin="0,12" Foreground="White"><UniformGrid Columns="2"><StackPanel><TextBlock Text="Intervalle par cible (ms, ≥ 500)"/><TextBox Text="{Binding Draft.IntervalMs}"/><TextBlock Text="Délai de réponse (ms, ≤ intervalle)"/><TextBox Text="{Binding Draft.TimeoutMs}"/><TextBlock Text="Fenêtre d’analyse (secondes, 10–300)"/><TextBox Text="{Binding Draft.WindowSeconds}"/></StackPanel><StackPanel><TextBlock Text="Alerte pertes ICMP (%)"/><TextBox Text="{Binding Draft.LossThreshold}"/><TextBlock Text="Alerte RTT p95 (ms)"/><TextBox Text="{Binding Draft.P95ThresholdMs}"/><TextBlock Text="Échecs consécutifs avant incident"/><TextBox Text="{Binding Draft.ConsecutiveFailures}"/><TextBlock Text="Attente après fermeture du jeu (secondes)"/><TextBox Text="{Binding Draft.CloseGraceSeconds}"/></StackPanel></UniformGrid></Expander>
<WrapPanel><Button Content="Enregistrer les paramètres" Click="SaveConfiguration"/><Button Content="Exporter toutes les données locales…" Click="ExportAll"/><Button Content="Supprimer toutes les données…" Click="DeleteAll"/></WrapPanel><TextBlock Text="Les sondes contactent uniquement vos cibles. Stockage local : %LOCALAPPDATA%\FreeNetworkMonitor. Aucun paquet privé n’est capturé. Les exports peuvent contenir vos adresses réseau et les chemins des jeux." TextWrapping="Wrap" Foreground="#BDCCDF" Margin="0,12"/>
</StackPanel></ScrollViewer></TabItem>
</TabControl><TextBlock Grid.Row="2" Text="{Binding Message}" TextWrapping="Wrap" Foreground="#50DFD2" Margin="0,12,0,0"/>
</Grid></Window>