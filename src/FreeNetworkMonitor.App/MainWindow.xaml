<Window x:Class="FreeNetworkMonitor.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Free Network Monitor" Width="1200" Height="820" MinWidth="850" MinHeight="620"><Grid Margin="24"><StackPanel><TextBlock Text="FREE NETWORK MONITOR" FontSize="27" FontWeight="Bold"/><TextBlock Text="Surveillance locale • données réelles • confidentialité" Foreground="#50DFD2"/><TextBlock x:Name="Status" Text="Initialisation…"/><Button Content="Suspendre / reprendre" Click="Toggle" HorizontalAlignment="Left"/><DataGrid x:Name="Rows" IsReadOnly="True" Height="330"><DataGrid.Columns><DataGridTextColumn Header="Destination" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="RTT moyen (ms)" Binding="{Binding Mean}" Width="160"/><DataGridTextColumn Header="Pertes sondes ICMP (%)" Binding="{Binding Loss}" Width="190"/><DataGridTextColumn Header="Échantillon / qualité" Binding="{Binding Quality}" Width="*"/></DataGrid.Columns></DataGrid><TextBlock TextWrapping="Wrap" Text="Pertes sur sondes ICMP uniquement. Aucune mesure directe des pertes UDP/TCP du jeu."/></StackPanel></Grid></Window>