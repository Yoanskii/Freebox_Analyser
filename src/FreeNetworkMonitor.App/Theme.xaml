<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<SolidColorBrush x:Key="Panel" Color="#1C2535"/><SolidColorBrush x:Key="Accent" Color="#50DFD2"/>
<Style TargetType="Window"><Setter Property="Background" Value="#101723"/><Setter Property="Foreground" Value="#EEF4FA"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="14"/></Style>
<Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E5EDF7"/><Setter Property="Margin" Value="0,4"/></Style>
<Style TargetType="Button"><Setter Property="Background" Value="#29465B"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="4"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" CornerRadius="7" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#367184"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#50DFD2"/><Setter TargetName="B" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="TextBox"><Setter Property="Background" Value="#263448"/><Setter Property="Foreground" Value="White"/><Setter Property="CaretBrush" Value="White"/><Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="4"/><Setter Property="BorderBrush" Value="#52647A"/></Style>
<Style TargetType="CheckBox"><Setter Property="Foreground" Value="White"/><Setter Property="Margin" Value="6"/></Style>
<Style TargetType="TabControl"><Setter Property="Background" Value="#101723"/><Setter Property="BorderThickness" Value="0"/></Style>
<Style TargetType="TabItem"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Tab" CornerRadius="7,7,0,0" Background="#243044" Padding="{TemplateBinding Padding}" BorderThickness="0,0,0,2" BorderBrush="Transparent" Margin="0,0,5,0"><ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="Background" Value="#30475B"/><Setter TargetName="Tab" Property="BorderBrush" Value="#50DFD2"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter><Setter Property="Foreground" Value="#121E2A"/><Setter Property="Padding" Value="20,10"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
<Style TargetType="DataGrid"><Setter Property="Background" Value="#1C2535"/><Setter Property="Foreground" Value="White"/><Setter Property="RowBackground" Value="#1C2535"/><Setter Property="AlternatingRowBackground" Value="#243044"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="MinRowHeight" Value="36"/><Setter Property="BorderThickness" Value="0"/><Setter Property="AutoGenerateColumns" Value="False"/></Style>
<Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#304259"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="8"/></Style>
<Style TargetType="DataGridCell"><Setter Property="Padding" Value="6"/><Setter Property="BorderThickness" Value="0"/></Style>
<Style TargetType="GroupBox"><Setter Property="Foreground" Value="White"/><Setter Property="Margin" Value="0,12"/><Setter Property="Padding" Value="10"/><Setter Property="BorderBrush" Value="#36475B"/></Style>
</ResourceDictionary>